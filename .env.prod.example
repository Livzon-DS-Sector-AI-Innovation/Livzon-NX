# Copy to .env.prod on the cloud server, then replace every change-me value.

# Images can be local build tags or registry images, e.g. ghcr.io/org/dazah-backend:2026-07-01.
BACKEND_IMAGE=dazah-backend:prod
FRONTEND_IMAGE=dazah-frontend:prod
HERMES_IMAGE=hermes-lite:prod

# Bind to 127.0.0.1 when Nginx/Caddy is the only public entrypoint.
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=3000
BACKEND_BIND=127.0.0.1
BACKEND_PORT=8000

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=dazah

SECRET_KEY=change-me-long-random-secret
# Fernet key for encrypting App Secret/API keys stored in DB.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-fernet-key
FRONTEND_URL=https://your-domain.example
JWT_EXPIRE_SECONDS=86400
AUDIT_RETENTION_DAYS=30

# Development-stage bootstrap accounts. Leave blank after creating real admin users if preferred.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin
BOOTSTRAP_ADMIN_NAME=系统管理员
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_USER_USERNAME=
BOOTSTRAP_USER_PASSWORD=
BOOTSTRAP_USER_NAME=
BOOTSTRAP_USER_EMAIL=
SSO_ADMIN_IDENTIFIERS=

# Service-to-service Agent tokens. These three must match across backend and Hermes-Lite.
HERMES_AGENT_TOKEN=change-me-hermes-agent-token
AGENT_TOOL_TOKEN=change-me-agent-tool-token
AGENT_LLM_PROXY_TOKEN=change-me-agent-llm-proxy-token
AGENT_INTERNAL_API_TOKEN=
AGENT_WRITE_CONFIRM_TTL_SECONDS=300
DAZAH_LLM_MODEL=dazah-active-text

# Optional web search key for Hermes-Lite web_search.
TAVILY_API_KEY=

# Feishu / Lark. Fill when SSO or module integrations are enabled.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=https://your-domain.example/api/v1/identity/auth/callback
FEISHU_WS_ENABLED=false

# Object storage. Use docker compose --profile storage if you want the bundled MinIO container.
MINIO_ENABLED=false
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-minio
MINIO_BUCKET_PREFIX=dazah
MINIO_SECURE=false

# Keep blank. Frontend should call backend through same-origin proxy/runtime API_BASE_URL.
NEXT_PUBLIC_API_BASE_URL=
