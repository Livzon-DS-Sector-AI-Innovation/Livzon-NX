# Dazah local Docker development configuration.
# Copy to .env.local. Values marked OPTIONAL may remain empty until that
# integration is exercised. These defaults must never be reused in production.

# === Development images / application ===
POSTGRES_IMAGE=postgres:17
REDIS_IMAGE=redis:8-alpine
MINIO_IMAGE=minio/minio:latest
APP_NAME=dazah-backend
APP_ENV=development
DEBUG=false
WATCHFILES_FORCE_POLLING=true
WATCHPACK_POLLING=true
NEXT_ALLOWED_DEV_ORIGINS=localhost,127.0.0.1,0.0.0.0
SECRET_KEY=local-development-only-change-me
ENCRYPTION_KEY=
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000
AUDIT_RETENTION_DAYS=7
JWT_EXPIRE_SECONDS=86400
DEV_BYPASS_AUTH=false
LOCAL_LOGIN_MODE=enabled
MODULE_ACCESS_MODE=all

# === Local accounts ===
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin
BOOTSTRAP_ADMIN_NAME=系统管理员
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_USER_USERNAME=user
BOOTSTRAP_USER_PASSWORD=change-me-user
BOOTSTRAP_USER_NAME=普通用户
BOOTSTRAP_USER_EMAIL=user@example.com
SSO_ADMIN_IDENTIFIERS=

# === PostgreSQL / Redis / MinIO ===
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dazah
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/dazah
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/dazah_test
REDIS_URL=redis://redis:6379/0
MINIO_ENABLED=true
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_PREFIX=dazah
MINIO_SECURE=false

# === Local Livzon / Hermes authentication ===
HERMES_AGENT_TOKEN=local-hermes-agent-token-change-me
HERMES_INTERNAL_TOKEN=local-hermes-internal-token-change-me
HERMES_AGENT_V2_URL=http://localhost:8100/v2/agent/runs
HERMES_INTERNAL_URL=http://localhost:8100
AGENT_LLM_PROXY_TOKEN=local-agent-llm-token-change-me
DAZAH_AGENT_TOOL_TOKEN=local-agent-tool-token-change-me
AGENT_TOOL_TOKEN=local-agent-tool-token-change-me
AGENT_INTERNAL_API_BASE_URL=http://localhost:8000/api/v1
AGENT_INTERNAL_API_TOKEN=
# Generate real Fernet values before testing persisted memory or Feishu credentials.
HERMES_USER_MEMORY_KEYS=
HERMES_USER_MEMORY_REQUIRE_POLICY=false
HERMES_FEISHU_CREDENTIAL_KEY=
AGENT_USER_MEMORY_MODE=auto
AGENT_USER_MEMORY_NOTICE_VERSION=1
LIVZON_FEISHU_ALLOWED_GROUPS=
AGENT_WRITE_CONFIRM_TTL_SECONDS=300
AGENT_HERMES_TIMEOUT_SECONDS=210
AGENT_INTERNAL_API_TIMEOUT_SECONDS=120
DAZAH_LLM_MODEL=dazah-active-text
DAZAH_API_BASE_URL=http://localhost:8000/api/v1
DAZAH_LLM_BASE_URL=http://localhost:8000/api/v1/agent/llm
HERMES_DAZAH_CHAT_TIMEOUT_SECONDS=180
HERMES_DAZAH_MAX_TOOL_ITERATIONS=30
LARK_CLI_TIMEOUT_SECONDS=90
MCP_AGENT_API_KEYS=

# === OPTIONAL: Feishu platform / Bitable ===
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=http://localhost:3000/api/v1/identity/auth/callback
FEISHU_SCOPES=contact:contact.base:readonly contact:user.base:readonly offline_access
FEISHU_SYNC_ROOT_DEPT_ID=
FEISHU_SYNC_MEMBER_DEPT_ID=
FEISHU_WS_ENABLED=false
FEISHU_EQUIPMENT_DEPT_ID=
FEISHU_EQUIPMENT_CHAT_ID=
FEISHU_SAFETY_CHAT_ID=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_EMPLOYEE_TABLE_ID=
FEISHU_BITABLE_DEPARTMENT_TABLE_ID=
FEISHU_BITABLE_OFFBOARDING_TABLE_ID=
FEISHU_BITABLE_ONBOARDING_TABLE_ID=
FEISHU_BITABLE_DEPARTURE_TABLE_ID=
FEISHU_BITABLE_APPROVAL_TABLE_ID=
FEISHU_BITABLE_PRODUCT_APP_TOKEN=
FEISHU_BITABLE_PRODUCT_TABLE_ID=
FEISHU_BITABLE_CONTRACT_MANAGEMENT_TABLE_ID=
FEISHU_BITABLE_POSITION_TRANSFER_TABLE_ID=
FEISHU_AI_QUERY_TABLES={}
FEISHU_AI_QUERY_MAX_ROWS=200

# Equipment integration is not used. Keep the backend's default-on WS off.
EQUIPMENT_FEISHU_WS_ENABLED=false
EQUIPMENT_FEISHU_APP_ID=
EQUIPMENT_FEISHU_APP_SECRET=

# === OPTIONAL: module integrations ===
HR_FEISHU_MEMBER_ROOT_DEPT_ID=
HR_FEISHU_MEMBER_EXTRA_ROOT_DEPT_IDS=
HR_FEISHU_MEMBER_EMPLOYEE_NO_PREFIX=112
HR_FEISHU_MEMBER_SYNC_INTERVAL_HOURS=12
HR_OFFBOARDING_REMINDER_OPEN_ID=
QUALITY_FEISHU_APP_TOKEN=
QUALITY_SOLID_BASE_TOKEN=
QUALITY_LIQUID_BASE_TOKEN=
QUALITY_FEISHU_DEVIATION_REPORT_TABLE_ID=
QUALITY_FEISHU_DEVIATION_INVESTIGATION_PUSH_TABLE_ID=
QUALITY_FEISHU_DEVIATION_TABLE_ID=
QUALITY_FEISHU_CAPA_TABLE_ID=
QUALITY_FEISHU_CAPA_PLAN_TABLE_ID=
QUALITY_DEPARTMENT_CONTACT_FEISHU_APP_TOKEN=
QUALITY_DEPARTMENT_CONTACT_FEISHU_TABLE_ID=
QUALITY_CHANGE_LEDGER_FEISHU_APP_TOKEN=
QUALITY_CHANGE_LEDGER_FEISHU_TABLE_ID=
QUALITY_CHANGE_ACTION_PLAN_FEISHU_APP_TOKEN=
QUALITY_CHANGE_ACTION_PLAN_FEISHU_TABLE_ID=
QUALITY_VALIDATION_FEISHU_APP_TOKEN=
QUALITY_VALIDATION_FEISHU_TABLE_ID=
FEISHU_BITABLE_TRAINING_NOTIFICATION_APP_TOKEN=
FEISHU_BITABLE_TRAINING_NOTIFICATION_TABLE_ID=

# Registration workbooks / Feishu event verification
REGISTRATION_AUTHORIZATION_SOURCE_DIR=./data/registration/授权书
REGISTRATION_WORKBOOK_DIR=./data/registration
REGISTRATION_PROJECT_LEDGER_WORKBOOK_NAME=1. 注册台账.xlsx
REGISTRATION_DECLARATION_PROGRESS_WORKBOOK_NAME=宁夏-注册项目信息统计表-2026.06.25.xlsx
REGISTRATION_CERTIFICATE_WORKBOOK_NAME=2. 药政证书台账.xlsx
FEISHU_EVENT_ENCRYPT_KEY=
FEISHU_EVENT_VERIFICATION_TOKEN=

# Optional independent Safety Feishu application
SAFETY_FEISHU_APP_ID=
SAFETY_FEISHU_APP_SECRET=
SAFETY_FEISHU_BITABLE_APP_TOKEN=
SAFETY_FEISHU_BITABLE_HAZARD_TABLE_ID=

# === OPTIONAL: external AI / search ===
MOONSHOT_API_KEY=
AI_MODEL=
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_ENCRYPTION_KEY=
TAVILY_API_KEY=

# === Crawler ===
DAILY_SYNC_CRON=0 2 * * *
CRAWLER_HEADLESS=true
CRAWLER_BROWSERS_PATH=

# === Local published ports ===
FRONTEND_BIND_HOST=0.0.0.0
FRONTEND_PORT=3000
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
BACKEND_BIND_HOST=0.0.0.0
BACKEND_PORT=8000
HERMES_BIND_HOST=127.0.0.1
HERMES_PORT=8100
EDBO_BIND_HOST=127.0.0.1
EDBO_PORT=8001
DB_BIND_HOST=127.0.0.1
DB_PORT=5432
REDIS_BIND_HOST=127.0.0.1
REDIS_PORT=6379
MINIO_BIND_HOST=127.0.0.1
MINIO_PORT=9000
MINIO_CONSOLE_BIND_HOST=127.0.0.1
MINIO_CONSOLE_PORT=9001

# === Existing development data volumes ===
POSTGRES_DATA_VOLUME=dazah-backend_pgdata
REDIS_DATA_VOLUME=dazah-backend_redisdata
MINIO_DATA_VOLUME=dazah-backend_minio_data
HERMES_DATA_VOLUME=hermes-lite_hermes_data
FRONTEND_NODE_MODULES_VOLUME=dazah-frontend_frontend_node_modules
FRONTEND_NEXT_CACHE_VOLUME=dazah-frontend_next-cache
