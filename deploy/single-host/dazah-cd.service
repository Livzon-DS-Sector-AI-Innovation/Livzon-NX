[Unit]
Description=Dazah trusted deployment controller
After=docker.service network-online.target
Wants=network-online.target

[Service]
Slice=dazah-control.slice
Type=oneshot
ExecStart=/usr/bin/python3 /opt/dazah/control/controller.py schedule
TimeoutStartSec=10800
UMask=0077
Nice=15
CPUWeight=10
IOWeight=10
MemoryMax=256M
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true
