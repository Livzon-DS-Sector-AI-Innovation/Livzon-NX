map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

# 页面上下文只选择后端鉴权规则，不授予权限。保留调用方显式页面路径，
# 缺失时才从同源 Referer 提取路径并剥离 query/fragment。来源比较包含
# scheme、Host 和端口；两者均缺失时不发送该头，后端继续拒绝无上下文请求。
map "$scheme://$http_host|$http_referer" $dazah_referer_page_path {
    default '';
    "~*^(https?://[^|/]+)[|]\\1(/[^?#]*)" $2;
    "~*^(https?://[^|/]+)[|]\\1(?:[?#].*)?$" /;
}

map $http_x_dazah_page_path $dazah_page_path {
    default $http_x_dazah_page_path;
    '' $dazah_referer_page_path;
}

# nginx 1.27 open-source supports periodically resolving upstream members when
# they are stored in a shared zone. This prevents Compose container recreation
# from leaving workers pinned to an obsolete Docker IP.
resolver 127.0.0.11 valid=5s ipv6=off;

upstream app_upstream {
    zone app_upstream 64k;
    server app:8000 resolve;
}

upstream frontend_upstream {
    zone frontend_upstream 64k;
    server frontend:3000 resolve;
}

server {
    include /etc/nginx/dazah-maintenance.conf;
    listen 80;
    listen [::]:80;
    server_name __PUBLIC_HOST__;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 308 https://__PUBLIC_HOST__$request_uri;
    }
}

server {
    include /etc/nginx/dazah-maintenance.conf;
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name __PUBLIC_HOST__;

    ssl_certificate /etc/letsencrypt/live/__PUBLIC_HOST__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__PUBLIC_HOST__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    listen 127.0.0.1:8090;
    client_max_body_size 100m;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    # 注入在 server 级：/api/、/uploads/、/mcp/ 等无自有 proxy_set_header 的
    # location 均继承此头；location /（前端）有自己的头集合，不受影响。
    proxy_set_header X-Dazah-Page-Path $dazah_page_path;

    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()" always;

    location /api/ {
        proxy_pass http://app_upstream;
        proxy_http_version 1.1;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location /uploads/ {
        proxy_pass http://app_upstream;
        proxy_http_version 1.1;
    }

    location /mcp/ {
        proxy_pass http://app_upstream;
        proxy_http_version 1.1;
        proxy_read_timeout 3600s;
    }

    location = /health {
        proxy_pass http://app_upstream;
        proxy_http_version 1.1;
    }

    location / {
        proxy_pass http://frontend_upstream;
        proxy_set_header Accept-Encoding $dazah_frontend_encoding;
        gzip on;
        sub_filter_once on;
        sub_filter '</body>' '<script src="/__dazah_maintenance_watch.js"></script></body>';
        proxy_http_version 1.1;
        # Keep the public host visible to Next.js Server Actions.
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
