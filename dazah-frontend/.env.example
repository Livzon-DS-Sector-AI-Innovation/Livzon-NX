# 后端 API 地址（FastAPI 服务）
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Next.js 环境
# NODE_ENV=development
# Docker Desktop 开发环境使用轮询，避免遗漏 Windows bind mount 文件事件。
WATCHPACK_POLLING=true

# 本地账号策略：开发环境默认 enabled，生产环境默认 disabled。
# 生产应急时可临时设为 admin_only，并与后端 LOCAL_LOGIN_MODE 保持一致。
# LOCAL_LOGIN_MODE=enabled

# Aily
NEXT_PUBLIC_AILY_APP_KEY=your-aily-app-key
NEXT_PUBLIC_AILY_BOT_NAME=your-aily-bot-name
