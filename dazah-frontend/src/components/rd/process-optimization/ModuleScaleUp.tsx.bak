'use client'

import { useState } from 'react'
import { Card, Button, Space, Tag, Table, Form, Input, InputNumber, Select, App, Tabs, Alert, Row, Col, Statistic, Descriptions } from 'antd'
import { CheckCircleOutlined, PlusOutlined, DeleteOutlined, ExpandOutlined } from '@ant-design/icons'
import type { ScaleUpStudy, ScaleUpBatch, DOEExperiment, LabConfirmationStudy } from '@/types/rd'

interface ModuleScaleUpProps {
  optimizationId: string
  doeExperiment?: DOEExperiment
  initialData?: ScaleUpStudy
  onComplete: (study: ScaleUpStudy) => void
  labConfirmationStudy?: LabConfirmationStudy
}

export function ModuleScaleUp({ optimizationId, doeExperiment, labConfirmationStudy, initialData, onComplete }: ModuleScaleUpProps) {
  const { message } = App.useApp()
  const [activeTab, setActiveTab] = useState('plan')
  const [targetScale, setTargetScale] = useState(initialData?.target_scale_kg || 5)
  const [materialBalance, setMaterialBalance] = useState(initialData?.material_balance || '')
  const [equipmentSelection, setEquipmentSelection] = useState(initialData?.equipment_selection || '')
  const [parameterAdjustments, setParameterAdjustments] = useState(initialData?.parameter_adjustments || '')
  const [batches, setBatches] = useState<ScaleUpBatch[]>(initialData?.batch ? [initialData.batch] : [])
  const [comparisonWithLab, setComparisonWithLab] = useState(initialData?.comparison_summary || '')
  const [conclusion, setConclusion] = useState(initialData?.conclusion || '')
  const [showForm, setShowForm] = useState(false)
  const [form] = Form.useForm()

  const handleAddBatch = async () => {
    try {
      const values = await form.validateFields()
      const newBatch: ScaleUpBatch = {
        id: `batch-${Date.now()}`,
        batch_no: values.batch_no || `SU-${new Date().getFullYear()}-${String(batches.length + 1).padStart(3, '0')}`,
        scale_kg: values.scale_kg,
        date: values.date,
        operator: values.operator,
        equipment: values.equipment,
        parameters: {},
        yield_pct: values.yield_pct,
        purity_pct: values.purity_pct,
        impurities_pct: values.impurities_pct,
        appearance: values.appearance,
        comparison_notes: values.comparison_notes,
        status: values.status || 'completed',
      }
      setBatches([...batches, newBatch])
      form.resetFields()
      setShowForm(false)
      message.success('批次记录已添加')
    } catch {}
  }

  const handleRemoveBatch = (id: string) => {
    setBatches(prev => prev.filter(b => b.id !== id))
  }

  const handleConfirm = () => {
    const study: ScaleUpStudy = {
      id: `scaleup-${optimizationId}`,
      target_scale_kg: targetScale,
      material_balance: materialBalance,
      equipment_selection: equipmentSelection,
      parameter_adjustments: parameterAdjustments,
      batch: batches[0],
      comparison_summary: comparisonWithLab,
      conclusion: conclusion || `公斤级放大试验完成，目标规模${targetScale}kg。`,
    }
    onComplete(study)
  }

  const avgYield = batches.length > 0 ? Math.round(batches.reduce((s, b) => s + b.yield_pct, 0) / batches.length * 10) / 10 : 0
  const avgPurity = batches.length > 0 ? Math.round(batches.reduce((s, b) => s + b.purity_pct, 0) / batches.length * 10) / 10 : 0

  const columns = [
    { title: '批号', dataIndex: 'batch_no', key: 'batch_no', width: 120 },
    { title: '规模(kg)', dataIndex: 'scale_kg', key: 'scale_kg', width: 80 },
    { title: '日期', dataIndex: 'date', key: 'date', width: 110 },
    { title: '操作人', dataIndex: 'operator', key: 'operator', width: 80 },
    { title: '设备', dataIndex: 'equipment', key: 'equipment', width: 120 },
    { title: '收率(%)', dataIndex: 'yield_pct', key: 'yield_pct', width: 80, render: (v: number) => `${v}%` },
    { title: '纯度(%)', dataIndex: 'purity_pct', key: 'purity_pct', width: 80, render: (v: number) => `${v}%` },
    { title: '杂质(%)', dataIndex: 'impurities_pct', key: 'impurities_pct', width: 80, render: (v: number) => v != null ? `${v}%` : '-' },
    { title: '外观', dataIndex: 'appearance', key: 'appearance', width: 100, render: (v: string) => v || '-' },
    {
      title: '状态',
      dataIndex: 'status',
      key: 'status',
      width: 80,
      render: (s: string) => <Tag color={s === 'completed' ? 'green' : s === 'failed' ? 'red' : 'blue'}>{s === 'completed' ? '完成' : s === 'failed' ? '失败' : '进行中'}</Tag>,
    },
    {
      title: '操作',
      key: 'action',
      width: 60,
      render: (_: unknown, record: ScaleUpBatch) => (
        <Button type="link" size="small" danger icon={<DeleteOutlined />} onClick={() => handleRemoveBatch(record.id)} />
      ),
    },
  ]

  return (
    <div>
      <Card>
        <Tabs
          activeKey={activeTab}
          onChange={setActiveTab}
          items={[
            {
              key: 'plan',
              label: <span><ExpandOutlined /> 5a. 放大方案</span>,
              children: (
                <div>
                  <Alert
                    title="公斤级放大试验"
                    description="在确认的优化参数基础上，设计公斤级放大方案，考察放大效应，验证工艺参数的可重复性。"
                    type="info"
                    showIcon
                    style={{ marginBottom: 16 }}
                  />

                  {doeExperiment?.analysis_result && (
                    <Alert
                      title="上游DOE最优参数"
                      description={
                        <div>
                          {Object.entries(doeExperiment.analysis_result.optimal_conditions).map(([k, v]) => {
                            const factor = doeExperiment.factors.find(f => f.symbol === k)
                            return <Tag key={k} color="blue" style={{ marginRight: 8 }}>{factor?.name || k}: {v} {factor?.unit || ''}</Tag>
                          })}
                        </div>
                      }
                      type="success"
                      showIcon
                      style={{ marginBottom: 16 }}
                    />
                  )}

                  <Row gutter={16} style={{ marginBottom: 16 }}>
                    <Col span={8}>
                      <div style={{ fontWeight: 500, marginBottom: 8 }}>目标放大规模 (kg)</div>
                      <InputNumber
                        style={{ width: '100%' }}
                        value={targetScale}
                        onChange={(v) => v && setTargetScale(v)}
                        min={1}
                        max={100}
                      />
                    </Col>
                  </Row>

                  <div style={{ marginBottom: 16 }}>
                    <div style={{ fontWeight: 500, marginBottom: 8 }}>物料衡算</div>
                    <Input.TextArea
                      rows={4}
                      value={materialBalance}
                      onChange={(e) => setMaterialBalance(e.target.value)}
                      placeholder="描述物料衡算方案，包括各步骤的投料量、理论产量、实际收率..."
                    />
                  </div>

                  <div style={{ marginBottom: 16 }}>
                    <div style={{ fontWeight: 500, marginBottom: 8 }}>设备选型</div>
                    <Input.TextArea
                      rows={3}
                      value={equipmentSelection}
                      onChange={(e) => setEquipmentSelection(e.target.value)}
                      placeholder="描述主要设备选型，如反应釜规格、搅拌类型、过滤设备等..."
                    />
                  </div>

                  <div style={{ marginBottom: 16 }}>
                    <div style={{ fontWeight: 500, marginBottom: 8 }}>参数调整说明</div>
                    <Input.TextArea
                      rows={3}
                      value={parameterAdjustments}
                      onChange={(e) => setParameterAdjustments(e.target.value)}
                      placeholder="描述从小试到公斤级需要调整的工艺参数（如搅拌速度、加料方式、温度控制等）..."
                    />
                  </div>

                  <Button type="primary" onClick={() => { setActiveTab('data'); message.info('请填写放大实验数据') }}>
                    下一步：录入实验数据 →
                  </Button>
                </div>
              ),
            },
            {
              key: 'data',
              label: <span>🧪 5b. 实验数据</span>,
              children: (
                <div>
                  <div style={{ marginBottom: 16 }}>
                    <Space>
                      <Button icon={<PlusOutlined />} onClick={() => setShowForm(true)}>➕ 添加批次</Button>
                      <Tag>共 {batches.length} 批</Tag>
                      {batches.length > 0 && <Tag color="green">平均收率: {avgYield}%</Tag>}
                      {batches.length > 0 && <Tag color="blue">平均纯度: {avgPurity}%</Tag>}
                    </Space>
                  </div>

                  {showForm && (
                    <Card size="small" style={{ marginBottom: 16, backgroundColor: '#fafafa' }}>
                      <Form form={form} layout="inline" style={{ flexWrap: 'wrap', gap: 8 }}>
                        <Form.Item name="batch_no" label="批号"><Input placeholder="自动生成" /></Form.Item>
                        <Form.Item name="scale_kg" label="规模(kg)" rules={[{ required: true }]}><InputNumber min={0.1} step={0.5} /></Form.Item>
                        <Form.Item name="date" label="日期" rules={[{ required: true }]}><Input placeholder="YYYY-MM-DD" /></Form.Item>
                        <Form.Item name="operator" label="操作人" rules={[{ required: true }]}><Input /></Form.Item>
                        <Form.Item name="equipment" label="设备"><Input placeholder="设备名称/规格" /></Form.Item>
                        <Form.Item name="yield_pct" label="收率(%)" rules={[{ required: true }]}><InputNumber min={0} max={100} step={0.1} /></Form.Item>
                        <Form.Item name="purity_pct" label="纯度(%)" rules={[{ required: true }]}><InputNumber min={0} max={100} step={0.1} /></Form.Item>
                        <Form.Item name="impurities_pct" label="杂质(%)"><InputNumber min={0} max={10} step={0.01} /></Form.Item>
                        <Form.Item name="appearance" label="外观"><Input placeholder="外观描述" /></Form.Item>
                        <Form.Item name="comparison_notes" label="对比备注"><Input placeholder="与小试对比" /></Form.Item>
                        <Form.Item>
                          <Space>
                            <Button type="primary" onClick={handleAddBatch}>保存</Button>
                            <Button onClick={() => { setShowForm(false); form.resetFields() }}>取消</Button>
                          </Space>
                        </Form.Item>
                      </Form>
                    </Card>
                  )}

                  <Table
                    columns={columns}
                    dataSource={batches}
                    rowKey="id"
                    pagination={false}
                    size="small"
                    scroll={{ x: 1000 }}
                  />
                </div>
              ),
            },
            {
              key: 'comparison',
              label: <span>📊 5c. 对比分析</span>,
              children: (
                <div>
                  <Row gutter={16} style={{ marginBottom: 16 }}>
                    <Col span={8}>
                      <Card size="small"><Statistic title="放大批次" value={batches.length} suffix="批" /></Card>
                    </Col>
                    <Col span={8}>
                      <Card size="small"><Statistic title="平均收率" value={avgYield} suffix="%" valueStyle={{ color: '#52c41a' }} /></Card>
                    </Col>
                    <Col span={8}>
                      <Card size="small"><Statistic title="平均纯度" value={avgPurity} suffix="%" valueStyle={{ color: '#1890ff' }} /></Card>
                    </Col>
                  </Row>

                  {doeExperiment?.analysis_result && (
                    <Card size="small" title="小试 vs 公斤级对比" style={{ marginBottom: 16 }}>
                      <Descriptions bordered size="small" column={3}>
                        <Descriptions.Item label="指标">小试(DOE最优)</Descriptions.Item>
                        <Descriptions.Item label="公斤级(平均)">偏差</Descriptions.Item>
                        <Descriptions.Item label="评估">
                          {Object.entries(doeExperiment.analysis_result.predicted_response).map(([name, value]) => (
                            <div key={name} style={{ marginBottom: 4 }}>
                              <strong>{name}：</strong>小试 {value} → 公斤级 {
                                name === '收率' ? avgYield : name === '纯度' ? avgPurity : '-'
                              }
                            </div>
                          ))}
                        </Descriptions.Item>
                      </Descriptions>
                    </Card>
                  )}

                  <div style={{ marginBottom: 16 }}>
                    <div style={{ fontWeight: 500, marginBottom: 8 }}>小试与公斤级对比分析</div>
                    <Input.TextArea
                      rows={4}
                      value={comparisonWithLab}
                      onChange={(e) => setComparisonWithLab(e.target.value)}
                      placeholder="对比分析小试和公斤级数据的差异，讨论放大效应..."
                    />
                  </div>

                  <div style={{ marginBottom: 16 }}>
                    <div style={{ fontWeight: 500, marginBottom: 8 }}>结论</div>
                    <Input.TextArea
                      rows={3}
                      value={conclusion}
                      onChange={(e) => setConclusion(e.target.value)}
                      placeholder="公斤级放大试验结论..."
                    />
                  </div>
                </div>
              ),
            },
          ]}
        />
      </Card>

      <Card>
        <Space>
          <Button
            type="primary"
            icon={<CheckCircleOutlined />}
            onClick={handleConfirm}
            size="large"
          >
            ✓ 确认并进入下一步（报告生成）
          </Button>
          <Tag>已完成 {batches.length} 批放大实验</Tag>
        </Space>
      </Card>
    </div>
  )
}
