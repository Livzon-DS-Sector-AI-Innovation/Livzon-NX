# Dazah production deployment configuration.
# Copy to .env on the Linux deployment host, set every REQUIRED value, then
# protect it with chmod 600. Never add the populated file to Git or an image.

# === Release images (all must already exist in the local Docker daemon) ===
DAZAH_VERSION=
POSTGRES_IMAGE=postgres:17
REDIS_IMAGE=redis:8-alpine
# Pin this to the exact MinIO release loaded on the server before deployment.
MINIO_IMAGE=

# === Application (REQUIRED) ===
APP_NAME=dazah-backend
APP_ENV=production
DEBUG=false
SECRET_KEY=
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
FRONTEND_URL=https://replace-with-production-host
AUDIT_RETENTION_DAYS=7
JWT_EXPIRE_SECONDS=86400

# Production defaults to disabled local login. Prefer SSO_ADMIN_IDENTIFIERS.
LOCAL_LOGIN_MODE=disabled
# All authenticated users can see and enter every business module.
MODULE_ACCESS_MODE=all
SSO_ADMIN_IDENTIFIERS=
# Emergency alternative only: set LOCAL_LOGIN_MODE=admin_only and fill these.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=系统管理员
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_USER_USERNAME=
BOOTSTRAP_USER_PASSWORD=
BOOTSTRAP_USER_NAME=普通用户
BOOTSTRAP_USER_EMAIL=

# === PostgreSQL / Redis (REQUIRED) ===
POSTGRES_USER=dazah
POSTGRES_PASSWORD=
POSTGRES_DB=dazah
# URL-encode special characters in the password used inside this URL.
DATABASE_URL=
REDIS_URL=redis://redis:6379/0

# === MinIO (REQUIRED) ===
MINIO_ENABLED=true
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_PREFIX=dazah
MINIO_SECURE=false

# === Livzon / Hermes service authentication (REQUIRED) ===
HERMES_AGENT_TOKEN=
HERMES_INTERNAL_TOKEN=
AGENT_LLM_PROXY_TOKEN=
DAZAH_AGENT_TOOL_TOKEN=
AGENT_INTERNAL_API_TOKEN=
# Comma-separated Fernet keys; first encrypts, remaining keys support rotation.
HERMES_USER_MEMORY_KEYS=
HERMES_USER_MEMORY_REQUIRE_POLICY=true
HERMES_FEISHU_CREDENTIAL_KEY=
AGENT_USER_MEMORY_MODE=auto
AGENT_USER_MEMORY_NOTICE_VERSION=1
LIVZON_FEISHU_ALLOWED_GROUPS=
AGENT_WRITE_CONFIRM_TTL_SECONDS=300
AGENT_HERMES_TIMEOUT_SECONDS=210
AGENT_INTERNAL_API_TIMEOUT_SECONDS=120
DAZAH_LLM_MODEL=dazah-active-text
HERMES_DAZAH_CHAT_TIMEOUT_SECONDS=180
HERMES_DAZAH_MAX_TOOL_ITERATIONS=30
LARK_CLI_TIMEOUT_SECONDS=90
MCP_AGENT_API_KEYS=

# === Platform Feishu application ===
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=https://replace-with-production-host/api/v1/identity/auth/callback
FEISHU_SCOPES=contact:contact.base:readonly contact:user.base:readonly offline_access
FEISHU_SYNC_ROOT_DEPT_ID=
FEISHU_SYNC_MEMBER_DEPT_ID=

# === HR / product Feishu Bitable ===
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_EMPLOYEE_TABLE_ID=
FEISHU_BITABLE_DEPARTMENT_TABLE_ID=
FEISHU_BITABLE_OFFBOARDING_TABLE_ID=
FEISHU_BITABLE_ONBOARDING_TABLE_ID=
FEISHU_BITABLE_DEPARTURE_TABLE_ID=
FEISHU_BITABLE_APPROVAL_TABLE_ID=
FEISHU_BITABLE_PRODUCT_APP_TOKEN=
FEISHU_BITABLE_PRODUCT_TABLE_ID=
FEISHU_AI_QUERY_TABLES={}
FEISHU_AI_QUERY_MAX_ROWS=200

# Equipment integration is not deployed. Keep the backend's default-on WS off.
EQUIPMENT_FEISHU_WS_ENABLED=false

# === Optional external AI / search integrations ===
MOONSHOT_API_KEY=
AI_MODEL=
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_ENCRYPTION_KEY=
TAVILY_API_KEY=

# === Crawler / storage ===
DAILY_SYNC_CRON=0 2 * * *
CRAWLER_HEADLESS=true
CRAWLER_BROWSERS_PATH=

# === Published ports ===
FRONTEND_BIND_HOST=0.0.0.0
FRONTEND_PORT=3000
BACKEND_BIND_HOST=127.0.0.1
BACKEND_PORT=8000
HERMES_BIND_HOST=127.0.0.1
HERMES_PORT=8100
MINIO_CONSOLE_BIND_HOST=127.0.0.1
MINIO_CONSOLE_PORT=9001

# === Container limits ===
POSTGRES_CPU_LIMIT=1.0
POSTGRES_MEMORY_LIMIT=2g
REDIS_CPU_LIMIT=0.5
REDIS_MEMORY_LIMIT=768m
MINIO_CPU_LIMIT=0.75
MINIO_MEMORY_LIMIT=1g
BACKEND_CPU_LIMIT=2.5
BACKEND_MEMORY_LIMIT=4g
EDBO_CPU_LIMIT=2.0
EDBO_MEMORY_LIMIT=3g
HERMES_CPU_LIMIT=1.0
HERMES_MEMORY_LIMIT=1g
FRONTEND_CPU_LIMIT=1.0
FRONTEND_MEMORY_LIMIT=1g
