# App
APP_NAME=dazah-backend
APP_ENV=development
DEBUG=true
# Docker Desktop 开发环境使用轮询，避免 Uvicorn 遗漏 Windows bind mount 文件事件。
WATCHFILES_FORCE_POLLING=true
SECRET_KEY=change-me-in-production
# Optional Fernet key for encrypting secrets stored in DB.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dazah
# Pytest must use a dedicated database. Tests may commit cleanup statements.
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dazah_test
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dazah
DB_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# Docker app container only.
# Keep DATABASE_URL/REDIS_URL on localhost for local Windows development.
# The Compose app profile uses these container-network URLs instead.
APP_DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/dazah
APP_REDIS_URL=redis://redis:6379/0

# Audit
AUDIT_RETENTION_DAYS=7

# Feishu (Lark) - platform app shared by SSO, org sync, IM and common Bitable access.
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=your_feishu_app_secret
FEISHU_REDIRECT_URI=http://localhost:3000/api/v1/identity/auth/callback
FEISHU_SCOPES=contact:contact.base:readonly contact:user.base:readonly offline_access
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=
# Keep false outside isolated local debugging; this never grants Agent rights.
DEV_BYPASS_AUTH=false

# Local login policy: development defaults to enabled; production defaults to disabled.
# Production recovery only: set admin_only temporarily, then restore disabled.
# enabled allows ordinary local users and is not recommended for production.
# LOCAL_LOGIN_MODE=enabled

# All authenticated users can see and enter every business module.
MODULE_ACCESS_MODE=all

# Local login bootstrap. Leave blank to skip creating that account.
# In production, prefer SSO_ADMIN_IDENTIFIERS instead of a standing local password.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin
BOOTSTRAP_ADMIN_NAME=系统管理员
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_USER_USERNAME=user
BOOTSTRAP_USER_PASSWORD=change-me-user
BOOTSTRAP_USER_NAME=普通用户
BOOTSTRAP_USER_EMAIL=user@example.com
# Comma-separated Feishu open_id/user_id/email/mobile/employee_no values promoted to admin.
# Production must configure this unless an emergency bootstrap admin is explicitly enabled.
SSO_ADMIN_IDENTIFIERS=

# Feishu org sync / common chat targets.
FEISHU_SYNC_ROOT_DEPT_ID=
FEISHU_SYNC_MEMBER_DEPT_ID=
FEISHU_WS_ENABLED=true
FEISHU_EQUIPMENT_DEPT_ID=
FEISHU_EQUIPMENT_CHAT_ID=
FEISHU_SAFETY_CHAT_ID=

# Feishu Bitable - HR module.
FEISHU_BITABLE_APP_TOKEN=base_or_wiki_converted_app_token
FEISHU_BITABLE_EMPLOYEE_TABLE_ID=tblEmployee
FEISHU_BITABLE_DEPARTMENT_TABLE_ID=tblDepartment
FEISHU_BITABLE_OFFBOARDING_TABLE_ID=tblOffboarding
FEISHU_BITABLE_ONBOARDING_TABLE_ID=tblOnboarding
FEISHU_BITABLE_DEPARTURE_TABLE_ID=tblDeparture
FEISHU_BITABLE_APPROVAL_TABLE_ID=tblApproval
FEISHU_BITABLE_CONTRACT_MANAGEMENT_TABLE_ID=
FEISHU_BITABLE_POSITION_TRANSFER_TABLE_ID=

# Optional HR Feishu contact synchronization.
HR_FEISHU_MEMBER_ROOT_DEPT_ID=
HR_FEISHU_MEMBER_EXTRA_ROOT_DEPT_IDS=
HR_FEISHU_MEMBER_EMPLOYEE_NO_PREFIX=112
HR_FEISHU_MEMBER_SYNC_INTERVAL_HOURS=12
HR_OFFBOARDING_REMINDER_OPEN_ID=

# Optional quality inspection bases. Do not commit real credentials here.
QUALITY_SOLID_BASE_TOKEN=
QUALITY_LIQUID_BASE_TOKEN=

# Registration workbook/template locations; no business attachments are copied.
REGISTRATION_AUTHORIZATION_SOURCE_DIR=./data/registration/授权书
REGISTRATION_WORKBOOK_DIR=./data/registration
REGISTRATION_PROJECT_LEDGER_WORKBOOK_NAME=1. 注册台账.xlsx
REGISTRATION_DECLARATION_PROGRESS_WORKBOOK_NAME=宁夏-注册项目信息统计表-2026.06.25.xlsx
REGISTRATION_CERTIFICATE_WORKBOOK_NAME=2. 药政证书台账.xlsx

FEISHU_EVENT_ENCRYPT_KEY=
FEISHU_EVENT_VERIFICATION_TOKEN=

# Feishu Bitable - product module.
FEISHU_BITABLE_PRODUCT_APP_TOKEN=
FEISHU_BITABLE_PRODUCT_TABLE_ID=

# Feishu AI Query
FEISHU_AI_QUERY_TABLES={}
FEISHU_AI_QUERY_MAX_ROWS=200

# Safety module - independent Feishu app and hazard Bitable.
SAFETY_FEISHU_APP_ID=
SAFETY_FEISHU_APP_SECRET=
SAFETY_FEISHU_BITABLE_APP_TOKEN=
SAFETY_FEISHU_BITABLE_HAZARD_TABLE_ID=

# 安全模块 - AI 模型配置（文本 / 视觉）
SAFETY_AI_TEXT_API_KEY           = your_safety_text_api_key
SAFETY_AI_TEXT_BASE_URL          = https://api.deepseek.com
SAFETY_AI_TEXT_MODEL             = deepseek-v4-flash
SAFETY_AI_VISION_API_KEY         = your_safety_vision_api_key
SAFETY_AI_VISION_BASE_URL        = https://dashscope.aliyuncs.com/compatible-mode/v1
SAFETY_AI_VISION_MODEL           = qwen-vl-max

# 设备模块 - 交互机器人
EQUIPMENT_FEISHU_WS_ENABLED=false
EQUIPMENT_FEISHU_APP_ID=
EQUIPMENT_FEISHU_APP_SECRET=

# Aily
AILY_APP_ID=your-aily-app-id

# AI
MOONSHOT_API_KEY=your-moonshot-api-key
AI_MODEL=kimi-k2.5

# MinIO / S3 对象存储（Docker 编排默认启用；非 Docker 本地开发可关闭）
MINIO_ENABLED=true
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_PREFIX=dazah
MINIO_SECURE=false

# MCP AI Agent API Keys (comma separated, for service-to-service authentication)
MCP_AGENT_API_KEYS=

# Hermes 中枢 Agent
# HERMES_AGENT_V2_URL points to the Hermes-Lite AgentBackend V2 adapter, for example:
# http://127.0.0.1:8100/v2/agent/runs
HERMES_AGENT_V2_URL=
HERMES_AGENT_TOKEN=
# Hermes internal Feishu control-plane endpoint, e.g. http://hermes-lite:8100.
HERMES_INTERNAL_URL=
HERMES_INTERNAL_TOKEN=
AGENT_USER_MEMORY_MODE=auto
AGENT_USER_MEMORY_NOTICE_VERSION=1
LIVZON_FEISHU_ALLOWED_GROUPS=
AGENT_TOOL_TOKEN=
AGENT_LLM_PROXY_TOKEN=
AGENT_INTERNAL_API_BASE_URL=http://127.0.0.1:8000/api/v1
AGENT_INTERNAL_API_TOKEN=
AGENT_WRITE_CONFIRM_TTL_SECONDS=300
# Backend -> Hermes-Lite request timeout. Keep this >= Hermes-Lite chat timeout.
AGENT_HERMES_TIMEOUT_SECONDS=210
# Backend Agent tool gateway internal HTTP timeout.
AGENT_INTERNAL_API_TIMEOUT_SECONDS=120

# Livzon assistant Feishu interactive-card callbacks.
# Set true in local/dev when Feishu cannot reach a public HTTPS callback URL.
